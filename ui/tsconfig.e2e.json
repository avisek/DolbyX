{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "ES2023",
    // DOM: page.evaluate callbacks run in the browser.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  // bootstrap.ts: the `window.__BOOTSTRAP__` global the specs assert on.
  "include": ["e2e", "playwright.config.ts", "src/lib/bootstrap.ts"]
}
