<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="20dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/TextAppearanceLarge"
        android:textSize="27sp"
        android:id="@+id/presetName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/off"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/revertButtonMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:src="@drawable/revert_profile"
        android:layout_alignBottom="@+id/presetName"
        android:soundEffectsEnabled="false"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/presetName"/>
    <EditText
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textSize="27sp"
        android:textStyle="normal"
        android:textColor="@color/white"
        android:id="@+id/presetNameEdit"
        android:background="@drawable/blueframe"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="5dp"
        android:inputType="textNoSuggestions"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="10dp"/>
</RelativeLayout>
