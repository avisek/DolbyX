<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="72sp"
    android:minHeight="72sp"
    android:soundEffectsEnabled="false"
    android:layout_marginStart="16sp"
    android:layout_marginEnd="16sp">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="55sp"
        android:layout_height="55sp"
        android:layout_marginTop="2sp"
        android:src="@drawable/icon"
        android:layout_alignParentTop="true"
        android:soundEffectsEnabled="false"
        android:layout_marginStart="10sp"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/revertButton"
        android:layout_width="35sp"
        android:layout_height="34sp"
        android:layout_marginTop="14sp"
        android:src="@drawable/revert_profile"
        android:layout_alignParentTop="true"
        android:soundEffectsEnabled="false"
        android:paddingEnd="14sp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16sp"
        android:singleLine="true"
        android:layout_alignParentTop="true"
        android:soundEffectsEnabled="false"
        android:layout_marginStart="0sp"
        android:layout_marginEnd="0sp"
        android:layout_alignEnd="@+id/revertButton"
        android:layout_alignParentStart="true"/>
    <EditText
        android:textSize="20sp"
        android:textStyle="normal"
        android:textColor="@color/white"
        android:id="@+id/nameEdit"
        android:background="@drawable/blueframe"
        android:visibility="gone"
        android:layout_width="192sp"
        android:layout_height="72sp"
        android:minHeight="61sp"
        android:layout_alignBaseline="@+id/name"
        android:soundEffectsEnabled="false"
        android:inputType="textNoSuggestions"
        android:layout_alignStart="@+id/name"/>
</RelativeLayout>
