<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="72sp"
    android:layout_marginLeft="16sp"
    android:layout_marginRight="16sp"
    android:minHeight="72sp"
    android:soundEffectsEnabled="false">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="55sp"
        android:layout_height="55sp"
        android:layout_marginLeft="10sp"
        android:layout_marginTop="2sp"
        android:src="@drawable/icon"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:soundEffectsEnabled="false"/>
    <ImageView
        android:id="@+id/revertButton"
        android:paddingRight="14sp"
        android:layout_width="35sp"
        android:layout_height="34sp"
        android:layout_marginTop="14sp"
        android:src="@drawable/revert_profile"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:soundEffectsEnabled="false"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="67sp"
        android:layout_marginTop="16sp"
        android:layout_marginRight="40sp"
        android:singleLine="true"
        android:layout_alignRight="@+id/revertButton"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:soundEffectsEnabled="false"/>
    <EditText
        android:textSize="20sp"
        android:textStyle="normal"
        android:textColor="@color/white"
        android:id="@+id/nameEdit"
        android:background="@drawable/blueframe"
        android:visibility="gone"
        android:layout_width="192sp"
        android:layout_height="72sp"
        android:minHeight="61sp"
        android:layout_alignBaseline="@+id/name"
        android:layout_alignLeft="@+id/name"
        android:soundEffectsEnabled="false"
        android:inputType="textNoSuggestions"/>
</RelativeLayout>
