<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20sp"
        android:layout_marginTop="20sp"
        android:layout_marginRight="20sp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/vlText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15sp"
            android:text="@string/volume_leveler"/>
        <ToggleButton
            android:id="@+id/vlButton"
            android:layout_width="128sp"
            android:layout_height="30sp"
            android:layout_marginBottom="20sp"
            android:layout_below="@+id/vlText"
            android:layout_alignParentLeft="true"
            style="@style/SwitchButton"/>
        <View
            android:background="#ff0e527a"
            android:layout_width="match_parent"
            android:layout_height="1.5sp"
            android:layout_below="@+id/vlButton"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20sp"
        android:layout_marginRight="20sp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/deText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:layout_marginBottom="15sp"
            android:text="@string/dialogue_enhancer"/>
        <ToggleButton
            android:id="@+id/deButton"
            android:layout_width="128sp"
            android:layout_height="30sp"
            android:layout_marginBottom="20sp"
            android:layout_below="@+id/deText"
            android:layout_alignParentLeft="true"
            style="@style/SwitchButton"/>
        <View
            android:background="#ff0e527a"
            android:layout_width="match_parent"
            android:layout_height="1.5sp"
            android:layout_below="@+id/deButton"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20sp"
        android:layout_marginRight="20sp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_color"
            android:id="@+id/svText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:layout_marginBottom="15sp"
            android:text="@string/surround_virtualizer"/>
        <ToggleButton
            android:id="@+id/svButton"
            android:layout_width="128sp"
            android:layout_height="30sp"
            android:layout_marginBottom="20sp"
            android:layout_below="@+id/svText"
            android:layout_alignParentLeft="true"
            style="@style/SwitchButton"/>
        <View
            android:background="#ff0e527a"
            android:layout_width="match_parent"
            android:layout_height="1.5sp"
            android:layout_below="@+id/svButton"/>
    </RelativeLayout>
</LinearLayout>
