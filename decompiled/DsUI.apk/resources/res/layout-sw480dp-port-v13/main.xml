<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:background="@drawable/topbackground"
            android:layout_width="match_parent"
            android:layout_height="150sp">
            <fragment
                android:name="com.dolby.ds1appUI.FragPower"
                android:id="@+id/fragpower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/dsLogo"
                android:layout_width="218sp"
                android:layout_height="52sp"
                android:layout_marginLeft="290sp"
                android:layout_marginTop="50sp"
                android:src="@drawable/dslogo"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"/>
        </FrameLayout>
        <View
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="1sp"/>
        <fragment
            android:name="com.dolby.ds1appUI.FragProfilePresets"
            android:id="@+id/fragprofilepresets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:background="@color/ltborder"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <fragment
            android:name="com.dolby.ds1appUI.FragProfilePresetEditor"
            android:id="@+id/fragprofileeditor"
            android:layout_width="wrap_content"
            android:layout_height="100sp"/>
        <fragment
            android:name="com.dolby.ds1appUI.FragGraphicVisualizer"
            android:id="@+id/fraggraphicvisualizer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:background="@color/ltborder"
            android:layout_width="match_parent"
            android:layout_height="1sp"
            android:layout_marginLeft="32sp"
            android:layout_marginTop="20sp"
            android:layout_marginRight="48sp"
            android:layout_marginBottom="26sp"/>
        <fragment
            android:name="com.dolby.ds1appUI.FragSwitches"
            android:id="@+id/fragswitches"
            android:layout_width="match_parent"
            android:layout_height="100sp"
            android:layout_marginLeft="25sp"
            android:layout_marginRight="60sp"/>
        <RelativeLayout
            android:id="@+id/copyrightBox"
            android:layout_width="match_parent"
            android:layout_height="45sp"/>
        <View
            android:background="@color/ltborder"
            android:layout_width="match_parent"
            android:layout_height="1sp"/>
    </LinearLayout>
</FrameLayout>
