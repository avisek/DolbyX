<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:paddingTop="20sp"
        android:paddingBottom="12sp"
        android:layout_width="match_parent"
        android:layout_height="0sp"
        android:layout_weight="1">
        <TextView
            android:textAppearance="@style/TextAppearanceLarge"
            android:textSize="32sp"
            android:id="@+id/presetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="230sp"
            android:text="@string/off"
            android:singleLine="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="20sp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/revertButtonMain"
            android:layout_width="21.5sp"
            android:layout_height="21.5sp"
            android:layout_marginBottom="6sp"
            android:src="@drawable/revert_profile"
            android:layout_alignBottom="@+id/presetName"
            android:soundEffectsEnabled="false"
            android:layout_marginStart="10sp"
            android:layout_toEndOf="@+id/presetName"/>
        <EditText
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="32sp"
            android:textStyle="normal"
            android:textColor="@color/white"
            android:id="@+id/presetNameEdit"
            android:background="@drawable/blueframe"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="42sp"
            android:layout_marginTop="3sp"
            android:inputType="textNoSuggestions"
            android:layout_marginStart="18sp"
            android:layout_marginEnd="18sp"/>
    </RelativeLayout>
</LinearLayout>
