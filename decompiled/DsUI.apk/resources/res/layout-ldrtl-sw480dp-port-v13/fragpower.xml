<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/powerButtonOff"
        android:layout_width="138sp"
        android:layout_height="133sp"
        android:src="@drawable/power_off"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/powerOff"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/powerButtonOn"
        android:layout_width="138sp"
        android:layout_height="133sp"
        android:src="@drawable/power_on"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/powerOn"
        android:layout_alignParentStart="true"/>
</RelativeLayout>
