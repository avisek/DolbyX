<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/TextAppearanceLarge"
            android:textSize="28sp"
            android:id="@+id/presetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="39sp"
            android:text="@string/off"
            android:layout_alignParentTop="true"
            android:layout_marginStart="29sp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/revertButtonMain"
            android:layout_width="25sp"
            android:layout_height="24sp"
            android:layout_marginBottom="6sp"
            android:src="@drawable/revert_profile"
            android:layout_alignBottom="@+id/presetName"
            android:soundEffectsEnabled="false"
            android:layout_marginStart="12sp"
            android:layout_toEndOf="@+id/presetName"/>
        <EditText
            android:textSize="48sp"
            android:textStyle="normal"
            android:textColor="@color/white"
            android:id="@+id/presetNameEdit"
            android:background="@drawable/blueframe"
            android:visibility="gone"
            android:layout_width="460sp"
            android:layout_height="64sp"
            android:layout_alignBaseline="@+id/presetName"
            android:inputType="textNoSuggestions"
            android:layout_alignStart="@+id/presetName"/>
    </RelativeLayout>
</LinearLayout>
