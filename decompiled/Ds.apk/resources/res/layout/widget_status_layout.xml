<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="275dp"
    android:layout_height="150dp">
    <ImageView
        android:id="@+id/vtop"
        android:background="#ff1888c9"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_alignParentTop="true"/>
    <ImageView
        android:id="@+id/vleft"
        android:background="#ff1888c9"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <ImageView
        android:id="@+id/vright"
        android:background="#ff1888c9"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="81dp"
        android:layout_toLeftOf="@+id/vright"
        android:layout_toRightOf="@+id/vleft"
        android:layout_below="@+id/vtop"
        layout="@layout/header"/>
    <ImageView
        android:id="@+id/vm1"
        android:background="#ff1888c9"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/header"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/widget_bottom1"
        android:background="#80000000"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_toLeftOf="@+id/vright"
        android:layout_toRightOf="@+id/vleft"
        android:layout_below="@+id/vm1"
        android:soundEffectsEnabled="false">
        <ImageView
            android:id="@+id/profile_1"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:src="@drawable/moviedis"
            android:scaleType="centerInside"
            android:layout_weight="1"
            android:soundEffectsEnabled="false"/>
        <TextView
            android:textSize="23sp"
            android:gravity="center_vertical"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/movie"
            android:layout_weight="2"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/vbottom"
        android:background="#ff1888c9"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@+id/widget_bottom1"/>
</RelativeLayout>
