<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="275dp"
    android:layout_height="247dp">
    <ImageView
        android:id="@+id/vtop"
        android:background="#ff1888c9"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_alignParentTop="true"/>
    <ImageView
        android:id="@+id/vleft"
        android:background="#ff1888c9"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <ImageView
        android:id="@+id/vright"
        android:background="#ff1888c9"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="81dp"
        android:layout_toLeftOf="@+id/vright"
        android:layout_toRightOf="@+id/vleft"
        android:layout_below="@+id/vtop"
        layout="@layout/header"/>
    <ImageView
        android:id="@+id/vm1"
        android:background="#ff1888c9"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/header"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/widget_bottom2"
        android:background="#80000000"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_toLeftOf="@+id/vright"
        android:layout_toRightOf="@+id/vleft"
        android:layout_below="@+id/vm1">
        <ImageView
            android:id="@+id/profile_1"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:src="@drawable/moviedis"
            android:scaleType="centerInside"
            android:layout_weight="1"
            android:soundEffectsEnabled="false"/>
        <ImageView
            android:background="#ff1888c9"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/profile_2"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:src="@drawable/musicdis"
            android:scaleType="centerInside"
            android:layout_weight="1"
            android:soundEffectsEnabled="false"/>
        <ImageView
            android:background="#ff1888c9"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/profile_3"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:src="@drawable/gamedis"
            android:scaleType="centerInside"
            android:layout_weight="1"
            android:soundEffectsEnabled="false"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/vm2"
        android:background="#ff1888c9"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/widget_bottom2"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/widget_bottom4"
        android:background="#80000000"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_toLeftOf="@+id/vright"
        android:layout_toRightOf="@+id/vleft"
        android:layout_below="@+id/vm2">
        <ImageView
            android:id="@+id/profile_4"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:src="@drawable/voicedis"
            android:scaleType="centerInside"
            android:layout_weight="1"
            android:soundEffectsEnabled="false"/>
        <ImageView
            android:background="#ff1888c9"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/profile_5"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:src="@drawable/preset1dis"
            android:scaleType="centerInside"
            android:layout_weight="1"
            android:soundEffectsEnabled="false"/>
        <ImageView
            android:background="#ff1888c9"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/profile_6"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:src="@drawable/preset2dis"
            android:scaleType="centerInside"
            android:layout_weight="1"
            android:soundEffectsEnabled="false"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/vbottom"
        android:background="#ff1888c9"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@+id/widget_bottom4"/>
</RelativeLayout>
